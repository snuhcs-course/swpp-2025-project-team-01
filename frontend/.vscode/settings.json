{
  // Java 설정
  "java.configuration.runtimes": [
    {
      "name": "JavaSE-21",
      "path": "C:\\Program Files\\Android\\Android Studio\\jbr",
      "default": true
    }
  ],
  "java.jdt.ls.java.home": "C:\\Program Files\\Android\\Android Studio\\jbr",

  // Android 프로젝트를 Java 분석에서 제외
  "java.import.gradle.enabled": false,
  "java.import.maven.enabled": false,
  "java.autobuild.enabled": false,

  // Dart/Flutter 설정
  "dart.flutterSdkPath": "C:\\Users\\thsus\\flutter",

  // Android 폴더 내 Java 파일을 분석 대상에서 제외
  "[java]": {
    "editor.defaultFormatter": "redhat.java"
  },
  "files.exclude": {
    "**/android/.gradle": true,
    "**/android/build": true,
    "**/android/.idea": true
  },

  // Java Language Server가 Android 프로젝트를 스캔하지 않도록
  "java.project.sourcePaths": [],
  "java.project.referencedLibraries": []
}
